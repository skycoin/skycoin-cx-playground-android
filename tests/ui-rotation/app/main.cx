package main

import "sys/app"

func main() {
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var w i32
	var h i32
	var shape str

	for bool.not(app.ShouldClose()) {
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.RESIZE {
				shape = "portrait"
				if ex > ey {
					shape = "landscape"
				}
				printf("resize %s %d x %d\n", shape, f32.i32(ex), f32.i32(ey))
			}
			if kind == app.TOUCH_UP {
				w, h = app.ScreenSize()
				printf("tap at %d %d on %d x %d\n", f32.i32(ex), f32.i32(ey), w, h)
			}
			kind, ex, ey, code = app.PollEvent()
		}
		w, h = app.ScreenSize()
		app.Clear(0.1, 0.1, 0.12)
		app.Text(sprintf("canvas %d x %d", w, h), 32.0, 40.0, 0.0, 1.0, 1.0, 1.0, 1.0)
		app.Rect(f32.sub(i32.f32(w), 100.0), f32.sub(i32.f32(h), 100.0), 100.0, 100.0, 0.2, 0.8, 0.3, 1.0)
		app.Frame()
	}
}
