package main

import "sys/app"

func main() {
	var w i32
	var h i32
	var cw f32
	var ch f32
	var rows i32 = 0
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var lines []str
	var total i32 = 0
	var top i32 = 0
	var i i32
	var reported i32 = -1

	for bool.not(app.ShouldClose()) {
		w, h = app.ScreenSize()
		cw, ch = app.CellSize()
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.KEY {
				if code == app.KEY_ENTER {
					total = total + 1
					lines = append(lines, sprintf("line %d", total))
				}
			}
			kind, ex, ey, code = app.PollEvent()
		}
		if cw > 0.0 {
			rows = f32.i32(f32.div(i32.f32(h), ch))
			// Thirty lines, more than the grid holds, so it starts scrolled.
			for total < 30 {
				total = total + 1
				lines = append(lines, sprintf("line %d", total))
			}
			top = total - rows
			if top < 0 {
				top = 0
			}
			if top != reported {
				reported = top
				printf("rows=%d top=line %d bottom=line %d\n", rows, top+1, total)
			}
		}

		app.Clear(0.0, 0.0, 0.0)
		for i = 0; i < rows; i++ {
			if top+i >= total {
				break
			}
			app.Text(lines[top+i], 0.0, f32.mul(i32.f32(i), ch), 0.0, 0.9, 0.9, 0.9, 1.0)
		}
		app.Frame()
	}
}
