package main

import "sys/app"

// direction names the main axis of a move by dx, dy.
func direction(dx f32, dy f32) (s str) {
	if f32.abs(dx) > f32.abs(dy) {
		s = "left"
		if dx > 0.0 {
			s = "right"
		}
	} else {
		s = "up"
		if dy > 0.0 {
			s = "down"
		}
	}
}

func main() {
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var x0 f32
	var y0 f32
	var moves i32 = 0
	var swipes i32 = 0
	var last str = "none"

	for bool.not(app.ShouldClose()) {
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.TOUCH_DOWN {
				x0 = ex
				y0 = ey
				moves = 0
			}
			if kind == app.TOUCH_MOVE {
				moves = moves + 1
			}
			if kind == app.TOUCH_UP {
				swipes = swipes + 1
				last = direction(ex-x0, ey-y0)
				printf("swipe %d %s from %d %d to %d %d moved=%v\n", swipes, last, f32.i32(x0), f32.i32(y0), f32.i32(ex), f32.i32(ey), moves > 2)
			}
			kind, ex, ey, code = app.PollEvent()
		}
		app.Clear(0.1, 0.1, 0.12)
		app.Text(sprintf("swipes: %d  last: %s", swipes, last), 32.0, 40.0, 0.0, 1.0, 1.0, 1.0, 1.0)
		app.Frame()
	}
}
