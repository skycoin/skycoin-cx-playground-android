	sha256RoundConstants[26] = 2952996808U
	sha256RoundConstants[27] = 3210313671U
	sha256RoundConstants[28] = 3336571891U
	sha256RoundConstants[29] = 3584528711U
	sha256RoundConstants[30] = 113926993U
	sha256RoundConstants[31] = 338241895U
	sha256RoundConstants[32] = 666307205U
	sha256RoundConstants[33] = 773529912U
	sha256RoundConstants[34] = 1294757372U
	sha256RoundConstants[35] = 1396182291U
	sha256RoundConstants[36] = 1695183700U
	sha256RoundConstants[37] = 1986661051U
	sha256RoundConstants[38] = 2177026350U
	sha256RoundConstants[39] = 2456956037U
	sha256RoundConstants[40] = 2730485921U
	sha256RoundConstants[41] = 2820302411U
	sha256RoundConstants[42] = 3259730800U
	sha256RoundConstants[43] = 3345764771U
	sha256RoundConstants[44] = 3516065817U
	sha256RoundConstants[45] = 3600352804U
	sha256RoundConstants[46] = 4094571909U
	sha256RoundConstants[47] = 275423344U
	sha256RoundConstants[48] = 430227734U
	sha256RoundConstants[49] = 506948616U
	sha256RoundConstants[50] = 659060556U
	sha256RoundConstants[51] = 883997877U
	sha256RoundConstants[52] = 958139571U
	sha256RoundConstants[53] = 1322822218U
	sha256RoundConstants[54] = 1537002063U
	sha256RoundConstants[55] = 1747873779U
	sha256RoundConstants[56] = 1955562222U
	sha256RoundConstants[57] = 2024104815U
	sha256RoundConstants[58] = 2227730452U
	sha256RoundConstants[59] = 2361852424U
	sha256RoundConstants[60] = 2428436474U
