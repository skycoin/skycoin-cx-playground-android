package main

// Test program 1 of skycoin-cx-playground-android #19: known answer hashes
// and memory pattern tests. Every test prints one result line, see
// testreport.Result: name, verdict, blocks/s, KB/s and latency in us.

import "sys/time"

var sha256RoundConstants [64]ui32
var sha256State [8]ui32
var sha256Schedule [64]ui32

// memoryWords is 128 KiB of ui32, the memory under test.
var memoryWords [32768]ui32

func sha256Reset() { global sha256State
	sha256State[0] = 1779033703U
	sha256State[1] = 3144134277U
	sha256State[2] = 1013904242U
	sha256State[3] = 2773480762U
	sha256State[4] = 1359893119U
	sha256State[5] = 2600822924U
	sha256State[6] = 528734635U
	sha256State[7] = 1541459225U
}

