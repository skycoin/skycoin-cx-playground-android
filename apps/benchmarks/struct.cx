package main

// Walks a [100]point through a pointer 2500 times.

type point struct {
	x i32
	y i32
}

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func main() {
	var h ui64
	h = 14695981039346656037UL
	var ok bool
	ok = true
	var points [100]point
	var i i32
	for i = 0; i < 100; i++ {
		points[i].x = i
		points[i].y = 2 * i
	}
	var sum i32
	var p *point
	var round i32
	for round = 0; round < 2500; round++ {
		sum = 0
		for i = 0; i < 100; i++ {
			p = &points[i]
			sum = sum + p.x + p.y
		}
		h = fnv(h, i32.ui64(sum))
		ok = ok && sum == 14850
	}
	ui64.print(h)
	if ok {
		printf("struct pass\n")
	} else {
		printf("struct FAIL\n")
	}
}
