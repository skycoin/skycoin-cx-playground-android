package main

import "sys/string"

// tapeSplitFields splits one tape line at its tabs and unescapes each field.
func tapeSplitFields(line str) (fields []str) {
	var rest str = line
	var tab i32 = string.ByteIndexOfFirstSubstring(rest, "\t")
	for tab >= 0 {
		fields = append(fields, tapeUnescape(string.SubstringByByteRange(rest, 0, tab)))
		rest = string.SubstringByByteRange(rest, tab + 1, string.ByteLength(rest))
		tab = string.ByteIndexOfFirstSubstring(rest, "\t")
	}
	fields = append(fields, tapeUnescape(rest))
}
