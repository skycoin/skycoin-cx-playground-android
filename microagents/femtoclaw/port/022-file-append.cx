package main

import "sys/string"
import "sys/os"

// fileAppend is the file system wrapper for appending to a file. A replay
// checks that the port appends what the recording did, and writes only with
// ++apply=1.
func fileAppend(path str, content str) (appended bool) {
	appended = true
	if gWrapperState.mode == WrapperModeReplay {
		var fields []str = tapeNext("file-append", 3)
		if !string.EqualityByByteValue(fields[1], path) {
			fatalStop(joinStrings([]str{"file-append to '", path, "', the tape has '", fields[1], "'"}))
		}
		if !string.EqualityByByteValue(fields[2], content) {
			fatalStop(joinStrings([]str{"file-append to '", path, "' differs from the tape"}))
		}
		if gWrapperState.applyWrites {
			existing, found := os.ReadAllText(liveFilePath(path))
			if !found {
				existing = ""
			}
			appended = liveFileWrite(liveFilePath(path), string.Concatenation(existing, content))
		}
		return
	}
	existing, found := os.ReadAllText(liveFilePath(path))
	if !found {
		existing = ""
	}
	appended = liveFileWrite(liveFilePath(path), string.Concatenation(existing, content))
	if gWrapperState.mode == WrapperModeRecord {
		tapeRecord([]str{"file-append", path, content})
	}
}
