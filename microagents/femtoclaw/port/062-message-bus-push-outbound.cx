package main

import "sys/string"

// message_bus_push_outbound as the host harness implements it: every
// outbound message is printed, and the printed text is the agent's output.
func messageBusPushOutbound(channel str, chatId str, content str) {
	string.PrintLine(joinStrings([]str{"--- outbound channel=", channel, " chat_id=", chatId, " bytes=", i32.str(string.ByteLength(content))}))
	string.PrintLine(content)
}
