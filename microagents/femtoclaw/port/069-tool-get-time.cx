package main

// Port of tool_get_time_execute of tools/tool_get_time.c, the branch for a
// clock that is already set. The HTTP Date header fallback is not ported.
func toolGetTime(inputJson str) (output str) {
	var now i64 = clockNow()
	if now > 1700000000L {
		output = joinStrings([]str{formatDateTime(now), " | epoch=", i64.str(now)})
		return
	}
	output = "Error: failed to fetch time (clock not set, HTTP fallback not ported)"
}
