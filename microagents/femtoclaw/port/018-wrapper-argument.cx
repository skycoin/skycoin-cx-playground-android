package main

import "sys/string"
import "sys/os"

// wrapperArgument returns the value of ++name=value on the command line.
func wrapperArgument(name str, fallback str) (value str) {
	value = fallback
	var prefix str = string.Concatenation(string.Concatenation("++", name), "=")
	var prefixLength i32 = string.ByteLength(prefix)
	for a := 0; a < len(os.Args); a++ {
		var argument str = os.Args[a]
		if string.ByteIndexOfFirstSubstring(argument, prefix) == 0 {
			value = string.SubstringByByteRange(argument, prefixLength, string.ByteLength(argument))
		}
	}
}
