package main

import "sys/string"

// netPost is the network wrapper for one HTTP POST to the model backend.
// A replay checks that the request is byte for byte the recorded one.
func netPost(url str, body str) (status i32, reply str) { global gWrapperState, WrapperModeReplay, WrapperModeRecord
	if gWrapperState.mode == WrapperModeReplay {
		var request []str = tapeNext("net-request", 3)
		if !string.EqualityByByteValue(request[1], url) {
			fatalStop(joinStrings([]str{"net-request to '", url, "', the tape has '", request[1], "'"}))
		}
		if !string.EqualityByByteValue(request[2], body) {
			fatalStop(joinStrings([]str{"net-request body of ", i32.str(string.ByteLength(body)), " bytes differs from the ", i32.str(string.ByteLength(request[2])), " recorded bytes"}))
		}
		var response []str = tapeNext("net-reply", 3)
		status = string.ParseDecimalI32(response[1])
		reply = response[2]
		return
	}
	status, reply = liveNetPost(url, body)
	if gWrapperState.mode == WrapperModeRecord {
		tapeRecord([]str{"net-request", url, body})
		tapeRecord([]str{"net-reply", i32.str(status), reply})
	}
}
