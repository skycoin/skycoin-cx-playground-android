package main

import "sys/string"

// jsonArrayItems returns the start of each element of the array at position.
func jsonArrayItems(s str, position i32) (items []i32) {
	var count i32 = string.ByteLength(s)
	var i i32 = jsonSkipSpace(s, position)
	if !string.EqualityByByteValue(string.SubstringByByteRange(s, i, i + 1), "[") {
		return
	}
	i = jsonSkipSpace(s, i + 1)
	if string.EqualityByByteValue(string.SubstringByByteRange(s, i, i + 1), "]") {
		return
	}
	for i < count {
		items = append(items, i)
		i = jsonSkipSpace(s, jsonSkipValue(s, i))
		if !string.EqualityByByteValue(string.SubstringByByteRange(s, i, i + 1), ",") {
			return
		}
		i = jsonSkipSpace(s, i + 1)
	}
}
