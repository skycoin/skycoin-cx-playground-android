package main

import "sys/string"

// jsonEscapeString quotes s the way cJSON_PrintUnformatted does: it escapes
// quote, backslash and control characters and copies every other byte.
func jsonEscapeString(s str) (quoted str) {
	var count i32 = string.ByteLength(s)
	var runStart i32 = 0
	quoted = "\""
	for i := 0; i < count; i++ {
		var c str = string.SubstringByByteRange(s, i, i + 1)
		var replacement str = ""
		if string.EqualityByByteValue(c, "\"") {
			replacement = "\\\""
		} else if string.EqualityByByteValue(c, "\\") {
			replacement = "\\\\"
		} else if string.OrderingByByteValue(c, " ") < 0 {
			var code i32 = byteValue(c)
			if code == 8 {
				replacement = "\\b"
			} else if code == 12 {
				replacement = "\\f"
			} else if code == 10 {
				replacement = "\\n"
			} else if code == 13 {
				replacement = "\\r"
			} else if code == 9 {
				replacement = "\\t"
			} else {
				replacement = string.Concatenation("\\u00", string.Concatenation(hexDigit(code / 16), hexDigit(code % 16)))
			}
		}
		if string.ByteLength(replacement) > 0 {
			quoted = string.Concatenation(quoted, string.SubstringByByteRange(s, runStart, i))
			quoted = string.Concatenation(quoted, replacement)
			runStart = i + 1
		}
	}
	quoted = string.Concatenation(quoted, string.SubstringByByteRange(s, runStart, count))
	quoted = string.Concatenation(quoted, "\"")
}
