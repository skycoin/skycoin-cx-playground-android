package main

import "sys/string"

// Port of build_tools_json of tools/tool_registry.c. Each schema literal is
// already compact, so cJSON prints it back unchanged.
func toolsJson(definitions []ToolDefinition) (json str) {
	json = "["
	for i := 0; i < len(definitions); i++ {
		if i > 0 {
			json = string.Concatenation(json, ",")
		}
		json = string.Concatenation(json, joinStrings([]str{"{\"name\":", jsonEscapeString(definitions[i].name), ",\"description\":", jsonEscapeString(definitions[i].description), ",\"input_schema\":", definitions[i].inputSchemaJson, "}"}))
	}
	json = string.Concatenation(json, "]")
}
