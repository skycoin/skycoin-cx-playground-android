package main

import "sys/string"

// byteValue returns the value of the one byte string c.
func byteValue(c str) (value i32) { global gWrapperState
	var low i32 = 0
	var high i32 = 255
	for low < high {
		var middle i32 = (low + high) / 2
		if string.OrderingByByteValue(gWrapperState.byteStrings[middle], c) < 0 {
			low = middle + 1
		} else {
			high = middle
		}
	}
	value = low
}
