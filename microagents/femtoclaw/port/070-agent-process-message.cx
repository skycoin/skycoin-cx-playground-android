package main

import "sys/string"

// One pass of the while loop of agent_loop_task of agent/agent_loop.c.
func agentProcessMessage(message InboundMessage, toolsJsonText str) {
	var systemPrompt str = contextBuildSystemPrompt()
	systemPrompt = agentTurnContext(systemPrompt, message)
	var messages []str = sessionHistoryMessages(message.chatId, FemtoAgentMaxHistory)
	messages = append(messages, joinStrings([]str{"{\"role\":\"user\",\"content\":", jsonEscapeString(message.content), "}"}))

	var finalText str = ""
	var iteration i32 = 0
	var sentWorkingStatus bool = false
	for iteration < FemtoAgentMaxToolIterations {
		if !sentWorkingStatus && !string.EqualityByByteValue(message.channel, FemtoChannelSystem) {
			messageBusPushOutbound(message.channel, message.chatId, "femto is working...")
			sentWorkingStatus = true
		}
		var reply LlmReply = llmChatTools(systemPrompt, messages, toolsJsonText)
		if !reply.succeeded {
			iteration = FemtoAgentMaxToolIterations
		} else if !reply.toolUse {
			finalText = reply.text
			iteration = FemtoAgentMaxToolIterations
		} else {
			messages = append(messages, joinStrings([]str{"{\"role\":\"assistant\",\"content\":", agentAssistantContent(reply), "}"}))
			messages = append(messages, joinStrings([]str{"{\"role\":\"user\",\"content\":", agentToolResults(reply), "}"}))
			iteration++
		}
	}

	if string.ByteLength(finalText) > 0 {
		var savedUser bool = sessionAppend(message.chatId, "user", message.content)
		var savedAssistant bool = sessionAppend(message.chatId, "assistant", finalText)
		messageBusPushOutbound(message.channel, message.chatId, finalText)
	} else {
		messageBusPushOutbound(message.channel, message.chatId, "Sorry, I encountered an error.")
	}
}
