package main

import "sys/string"

// The anthropic branch of the response parsing in llm_chat_tools of
// llm/llm_proxy.c: stop_reason, the text blocks joined, and the tool_use blocks.
func llmParseReply(response str) (reply LlmReply) {
	reply.succeeded = false
	reply.toolUse = false
	reply.text = ""
	var start i32 = jsonSkipSpace(response, 0)
	if !string.EqualityByByteValue(string.SubstringByByteRange(response, start, start + 1), "{") {
		return
	}
	reply.succeeded = true
	stopReason, stopFound := jsonStringField(response, start, "stop_reason")
	if stopFound {
		reply.toolUse = string.EqualityByByteValue(stopReason, "tool_use")
	}
	contentPosition, contentFound := jsonObjectField(response, start, "content")
	if !contentFound {
		return
	}
	var blocks []i32 = jsonArrayItems(response, contentPosition)
	for i := 0; i < len(blocks); i++ {
		blockType, typeFound := jsonStringField(response, blocks[i], "type")
		if typeFound && string.EqualityByByteValue(blockType, "text") {
			text, textFound := jsonStringField(response, blocks[i], "text")
			if textFound {
				reply.text = string.Concatenation(reply.text, text)
			}
		}
	}
	for i := 0; i < len(blocks); i++ {
		callType, callTypeFound := jsonStringField(response, blocks[i], "type")
		if callTypeFound && string.EqualityByByteValue(callType, "tool_use") {
			if len(reply.calls) >= FemtoMaxToolCalls {
				return
			}
			var call ToolCall
			id, idFound := jsonStringField(response, blocks[i], "id")
			name, nameFound := jsonStringField(response, blocks[i], "name")
			call.id = id
			call.name = name
			call.inputJson = ""
			inputPosition, inputFound := jsonObjectField(response, blocks[i], "input")
			if inputFound {
				input, afterInput := jsonCompactValue(response, inputPosition)
				call.inputJson = input
			}
			reply.calls = append(reply.calls, call)
		}
	}
}
