package main

// hexValue returns the value of one hex digit, or -1.
func hexValue(c str) (value i32) {
	var code i32 = byteValue(c)
	value = -1
	if code >= 48 && code <= 57 {
		value = code - 48
	} else if code >= 97 && code <= 102 {
		value = code - 87
	} else if code >= 65 && code <= 70 {
		value = code - 55
	}
}
