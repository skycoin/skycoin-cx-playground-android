package main

import "sys/string"

// jsonCompactValue prints the JSON value at position without white space,
// as cJSON_PrintUnformatted prints a parsed value. Numbers are copied as
// written, which matches cJSON for integers only.
func jsonCompactValue(s str, position i32) (compact str, next i32) {
	var start i32 = jsonSkipSpace(s, position)
	var c str = string.SubstringByByteRange(s, start, start + 1)
	var closing str = ""
	if string.EqualityByByteValue(c, "\"") {
		value, after := jsonScanString(s, start)
		compact = jsonEscapeString(value)
		next = after
		return
	}
	if string.EqualityByByteValue(c, "{") {
		closing = "}"
	} else if string.EqualityByByteValue(c, "[") {
		closing = "]"
	} else {
		next = jsonSkipValue(s, start)
		compact = string.SubstringByByteRange(s, start, next)
		return
	}
	compact = c
	var i i32 = jsonSkipSpace(s, start + 1)
	if string.EqualityByByteValue(string.SubstringByByteRange(s, i, i + 1), closing) {
		compact = string.Concatenation(compact, closing)
		next = i + 1
		return
	}
	var more bool = true
	for more {
		if string.EqualityByByteValue(closing, "}") {
			key, afterKey := jsonScanString(s, jsonSkipSpace(s, i))
			compact = string.Concatenation(compact, string.Concatenation(jsonEscapeString(key), ":"))
			i = jsonSkipSpace(s, afterKey) + 1
		}
		element, afterElement := jsonCompactValue(s, i)
		compact = string.Concatenation(compact, element)
		i = jsonSkipSpace(s, afterElement)
		var separator str = string.SubstringByByteRange(s, i, i + 1)
		i = i + 1
		if string.EqualityByByteValue(separator, ",") {
			compact = string.Concatenation(compact, ",")
		} else {
			more = false
		}
	}
	compact = string.Concatenation(compact, closing)
	next = i
}
