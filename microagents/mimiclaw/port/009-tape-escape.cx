package main

import "sys/string"

// tapeEscape makes s fit one tab separated field of one tape line.
func tapeEscape(s str) (escaped str) {
	var count i32 = string.ByteLength(s)
	var runStart i32 = 0
	escaped = ""
	for i := 0; i < count; i++ {
		var c str = string.SubstringByByteRange(s, i, i + 1)
		var replacement str = ""
		if string.EqualityByByteValue(c, "\\") {
			replacement = "\\\\"
		} else if string.EqualityByByteValue(c, "\n") {
			replacement = "\\n"
		} else if string.EqualityByByteValue(c, "\t") {
			replacement = "\\t"
		} else if string.EqualityByByteValue(c, "\r") {
			replacement = "\\r"
		}
		if string.ByteLength(replacement) > 0 {
			escaped = string.Concatenation(escaped, string.SubstringByByteRange(s, runStart, i))
			escaped = string.Concatenation(escaped, replacement)
			runStart = i + 1
		}
	}
	escaped = string.Concatenation(escaped, string.SubstringByByteRange(s, runStart, count))
}
