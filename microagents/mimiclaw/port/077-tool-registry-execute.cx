package main

import "sys/string"

// Port of tool_registry_execute of tools/tool_registry.c.
func toolRegistryExecute(name str, inputJson str) (output str) {
	var definitions []ToolDefinition = toolDefinitions()
	for i := 0; i < len(definitions); i++ {
		if string.EqualityByByteValue(definitions[i].name, name) {
			if string.EqualityByByteValue(name, "get_current_time") {
				output = toolGetTime(inputJson)
			} else if string.EqualityByByteValue(name, "read_file") {
				output = toolReadFile(inputJson)
			} else if string.EqualityByByteValue(name, "write_file") {
				output = toolWriteFile(inputJson)
			} else if string.EqualityByByteValue(name, "edit_file") {
				output = toolEditFile(inputJson)
			} else if string.EqualityByByteValue(name, "list_dir") {
				output = toolListDir(inputJson)
			} else {
				output = toolUnavailable(name)
			}
			return
		}
	}
	output = joinStrings([]str{"Error: unknown tool '", name, "'"})
}
