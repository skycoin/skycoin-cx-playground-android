package main

// civilDate converts days since 1970-01-01 to a year, month and day, the
// part of localtime_r the port needs in UTC. Algorithm from
// https://howardhinnant.github.io/date_algorithms.html#civil_from_days
func civilDate(days i64) (year i64, month i64, day i64) {
	var z i64 = days + 719468L
	var era i64 = z / 146097L
	var dayOfEra i64 = z - era * 146097L
	var yearOfEra i64 = (dayOfEra - dayOfEra / 1460L + dayOfEra / 36524L - dayOfEra / 146096L) / 365L
	var dayOfYear i64 = dayOfEra - (365L * yearOfEra + yearOfEra / 4L - yearOfEra / 100L)
	var monthIndex i64 = (5L * dayOfYear + 2L) / 153L
	day = dayOfYear - (153L * monthIndex + 2L) / 5L + 1L
	month = monthIndex + 3L
	if monthIndex >= 10L {
		month = monthIndex - 9L
	}
	year = yearOfEra + era * 400L
	if month <= 2L {
		year = year + 1L
	}
}
