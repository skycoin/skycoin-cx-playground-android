package main

import "sys/string"

// jsonSkipValue returns the position just after the JSON value at position.
func jsonSkipValue(s str, position i32) (next i32) {
	var count i32 = string.ByteLength(s)
	var start i32 = jsonSkipSpace(s, position)
	var c str = string.SubstringByByteRange(s, start, start + 1)
	if string.EqualityByByteValue(c, "\"") {
		skipped, after := jsonScanString(s, start)
		next = after
		return
	}
	if string.EqualityByByteValue(c, "{") || string.EqualityByByteValue(c, "[") {
		var depth i32 = 0
		var i i32 = start
		for i < count {
			var d str = string.SubstringByByteRange(s, i, i + 1)
			if string.EqualityByByteValue(d, "\"") {
				inner, afterString := jsonScanString(s, i)
				i = afterString
			} else {
				if string.EqualityByByteValue(d, "{") || string.EqualityByByteValue(d, "[") {
					depth++
				} else if string.EqualityByByteValue(d, "}") || string.EqualityByByteValue(d, "]") {
					depth--
				}
				i++
				if depth == 0 {
					next = i
					return
				}
			}
		}
		next = count
		return
	}
	next = start
	for next < count {
		var e str = string.SubstringByByteRange(s, next, next + 1)
		if string.EqualityByByteValue(e, ",") || string.EqualityByByteValue(e, "}") || string.EqualityByByteValue(e, "]") || string.EqualityByByteValue(e, " ") || string.EqualityByByteValue(e, "\n") || string.EqualityByByteValue(e, "\r") || string.EqualityByByteValue(e, "\t") {
			return
		}
		next++
	}
}
