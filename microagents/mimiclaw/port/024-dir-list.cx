package main

import "sys/string"
import "sys/os"

// dirList is the file system wrapper for listing the files of /spiffs, the
// port of opendir and readdir. SPIFFS is flat, so the names are the file
// paths below /spiffs in byte order. backendstore listdir lists them live.
func dirList() (names []str, found bool) {
	var listing str = ""
	if gWrapperState.mode == WrapperModeReplay {
		var fields []str = tapeNext("dir-list", 4)
		found = string.EqualityByByteValue(fields[2], "ok")
		listing = fields[3]
	} else {
		runError, exitCode, output := os.Run(joinStrings([]str{gWrapperState.clientCommand, " listdir -root spiffs"}), 0, 300000, ".")
		found = runError == 0 && exitCode == 0
		if found {
			listing = output
		}
		if gWrapperState.mode == WrapperModeRecord {
			var result str = "failed"
			if found {
				result = "ok"
			}
			tapeRecord([]str{"dir-list", "/spiffs", result, listing})
		}
	}
	names = splitLines(listing)
}
