package main

import "sys/string"

// skillReadLine is fgets into a buffer of size bytes over a file read
// whole: up to size - 1 bytes from position, ending after the first newline.
func skillReadLine(content str, position i32, size i32) (line str, next i32, found bool) {
	var count i32 = string.ByteLength(content)
	found = position < count
	line = ""
	next = position
	if !found {
		return
	}
	var end i32 = position + size - 1
	if end > count {
		end = count
	}
	var rest str = string.SubstringByByteRange(content, position, end)
	var newline i32 = string.ByteIndexOfFirstSubstring(rest, "\n")
	if newline >= 0 {
		rest = string.SubstringByByteRange(rest, 0, newline + 1)
	}
	line = rest
	next = position + string.ByteLength(rest)
}
