package main

// The static state of agent.c and ratelimit.c, and the key value store of
// memory.c and the user tools of user_tools.c as the host mocks keep them.
type AgentState struct {
	history []ConversationMessage
	persona str
	paused bool
	lastStartResponseUs i64
	lastNonCommandResponseUs i64
	lastNonCommandText str
	requestsThisHour i32
	requestsToday i32
	lastHour i64
	lastDay i64
	lastYear i64
	memoryKeys []str
	memoryValues []str
	userToolNames []str
	userToolDescriptions []str
	userToolActions []str
}
