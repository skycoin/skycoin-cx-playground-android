package main

import "sys/string"

// Port of json_parse_response and parse_anthropic_response of json_util.c.
// The last text block and the last tool_use block win, as each overwrites
// the output buffers. Text, name and id are cut to their C buffers.
func jsonParseResponse(response str) (result ParsedResponse) {
	result.parsed = false
	result.text = ""
	result.toolName = ""
	result.toolId = ""
	result.toolInput = ""
	var start i32 = jsonSkipSpace(response, 0)
	if !string.EqualityByByteValue(string.SubstringByByteRange(response, start, start + 1), "{") {
		return
	}
	errorPosition, errorFound := jsonObjectField(response, start, "error")
	if errorFound {
		message, messageFound := jsonStringField(response, errorPosition, "message")
		result.text = "API Error (unknown)"
		if messageFound {
			result.text = truncateBytes(string.Concatenation("API Error: ", message), ZclawMaxMessageLength - 1)
		}
		result.parsed = true
		return
	}
	contentPosition, contentFound := jsonObjectField(response, start, "content")
	if !contentFound || !string.EqualityByByteValue(string.SubstringByByteRange(response, contentPosition, contentPosition + 1), "[") {
		return
	}
	var blocks []i32 = jsonArrayItems(response, contentPosition)
	for i := 0; i < len(blocks); i++ {
		blockType, typeFound := jsonStringField(response, blocks[i], "type")
		if typeFound && string.EqualityByByteValue(blockType, "text") {
			text, textFound := jsonStringField(response, blocks[i], "text")
			if textFound {
				result.text = truncateBytes(text, ZclawMaxMessageLength - 1)
			}
		} else if typeFound && string.EqualityByByteValue(blockType, "tool_use") {
			name, nameFound := jsonStringField(response, blocks[i], "name")
			if nameFound {
				result.toolName = truncateBytes(name, ZclawToolNameLength - 1)
			}
			id, idFound := jsonStringField(response, blocks[i], "id")
			if idFound {
				result.toolId = truncateBytes(id, ZclawToolIdLength - 1)
			}
			inputPosition, inputFound := jsonObjectField(response, blocks[i], "input")
			if inputFound {
				input, afterInput := jsonCompactValue(response, inputPosition)
				result.toolInput = input
			}
		}
	}
	result.parsed = true
}
