package main

// The built-in tools of builtin_tools.def, in table order.
func toolDefinitions() (definitions []ToolDefinition) {
	definitions = append(definitions, ToolDefinition{name: "gpio_write", description: "Set an allowed GPIO HIGH or LOW.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"},\"state\":{\"type\":\"integer\"}},\"required\":[\"pin\",\"state\"]}"})
	definitions = append(definitions, ToolDefinition{name: "gpio_read", description: "Read an allowed GPIO.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"}},\"required\":[\"pin\"]}"})
	definitions = append(definitions, ToolDefinition{name: "gpio_read_all", description: "Read all allowed GPIO states.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "delay", description: "Wait in milliseconds.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"milliseconds\":{\"type\":\"integer\"}},\"required\":[\"milliseconds\"]}"})
	definitions = append(definitions, ToolDefinition{name: "i2c_scan", description: "Scan an I2C bus for devices.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\"]}"})
	definitions = append(definitions, ToolDefinition{name: "i2c_write", description: "Write hex bytes to an I2C address.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"data_hex\":{\"type\":\"string\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"data_hex\"]}"})
	definitions = append(definitions, ToolDefinition{name: "i2c_read", description: "Read bytes from an I2C address.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"read_length\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"read_length\"]}"})
	definitions = append(definitions, ToolDefinition{name: "i2c_write_read", description: "Write hex bytes, then read from the same I2C address.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"write_hex\":{\"type\":\"string\"},\"read_length\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"write_hex\",\"read_length\"]}"})
	definitions = append(definitions, ToolDefinition{name: "dht_read", description: "Read a DHT11 or DHT22 sensor.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"},\"model\":{\"type\":\"string\",\"enum\":[\"dht11\",\"dht22\"]},\"retries\":{\"type\":\"integer\"}},\"required\":[\"pin\",\"model\"]}"})
	definitions = append(definitions, ToolDefinition{name: "memory_set", description: "Store a user memory value.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"key\",\"value\"]}"})
	definitions = append(definitions, ToolDefinition{name: "memory_get", description: "Read a user memory value.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}"})
	definitions = append(definitions, ToolDefinition{name: "memory_list", description: "List user memory keys.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "memory_delete", description: "Delete a user memory key.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}"})
	definitions = append(definitions, ToolDefinition{name: "set_persona", description: "Set the assistant persona when the user explicitly asks.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"persona\":{\"type\":\"string\",\"enum\":[\"neutral\",\"friendly\",\"technical\",\"witty\"]}},\"required\":[\"persona\"]}"})
	definitions = append(definitions, ToolDefinition{name: "get_persona", description: "Get the current assistant persona.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "reset_persona", description: "Reset the assistant persona to neutral.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "cron_set", description: "Create a scheduled task.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"periodic\",\"daily\",\"once\"]},\"interval_minutes\":{\"type\":\"integer\"},\"delay_minutes\":{\"type\":\"integer\"},\"hour\":{\"type\":\"integer\"},\"minute\":{\"type\":\"integer\"},\"action\":{\"type\":\"string\"}},\"required\":[\"type\",\"action\"]}"})
	definitions = append(definitions, ToolDefinition{name: "cron_list", description: "List scheduled tasks.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "cron_delete", description: "Delete a scheduled task.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}"})
	definitions = append(definitions, ToolDefinition{name: "get_time", description: "Get local device time.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "set_timezone", description: "Set the device timezone.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"timezone\":{\"type\":\"string\"}},\"required\":[\"timezone\"]}"})
	definitions = append(definitions, ToolDefinition{name: "get_timezone", description: "Get the device timezone.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "get_version", description: "Get firmware version.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "get_health", description: "Get device health.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "get_diagnostics", description: "Get runtime diagnostics.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"scope\":{\"type\":\"string\",\"enum\":[\"quick\",\"runtime\",\"memory\",\"rates\",\"time\",\"all\"]},\"verbose\":{\"type\":\"boolean\"}}}"})
	definitions = append(definitions, ToolDefinition{name: "create_tool", description: "Create a user tool.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"action\":{\"type\":\"string\"}},\"required\":[\"name\",\"description\",\"action\"]}"})
	definitions = append(definitions, ToolDefinition{name: "list_user_tools", description: "List user-created tools.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{}}"})
	definitions = append(definitions, ToolDefinition{name: "delete_user_tool", description: "Delete a user-created tool.", inputSchemaJson: "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}"})
}
