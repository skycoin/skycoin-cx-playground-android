package main

import "sys/string"

// jsonStringField returns the string member name of the object at position,
// the port of cJSON_GetObjectItem followed by cJSON_IsString.
func jsonStringField(s str, position i32, name str) (value str, found bool) {
	value = ""
	valuePosition, present := jsonObjectField(s, position, name)
	found = false
	if !present {
		return
	}
	if !string.EqualityByByteValue(string.SubstringByByteRange(s, valuePosition, valuePosition + 1), "\"") {
		return
	}
	decoded, after := jsonScanString(s, valuePosition)
	value = decoded
	found = true
}
