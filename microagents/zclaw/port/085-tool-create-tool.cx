package main

import "sys/string"

// Port of tools_create_tool_handler of tools_system.c with user_tools_create
// of the host mock, which keeps up to MAX_DYNAMIC_TOOLS tools, cut to their
// buffers, and does not check for duplicates.
func toolCreateTool(inputJson str) (ok bool, result str) {
	ok = false
	name, nameFound := jsonStringField(inputJson, 0, "name")
	description, descriptionFound := jsonStringField(inputJson, 0, "description")
	action, actionFound := jsonStringField(inputJson, 0, "action")
	if !nameFound {
		result = "Error: 'name' required (string, no spaces)"
		return
	}
	if !descriptionFound {
		result = "Error: 'description' required (short description)"
		return
	}
	if !actionFound {
		result = "Error: 'action' required (what to do when called)"
		return
	}
	var allowed str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
	for i := 0; i < string.ByteLength(name); i++ {
		if string.ByteIndexOfFirstSubstring(allowed, string.SubstringByByteRange(name, i, i + 1)) < 0 {
			result = "Error: name must be alphanumeric/underscore, no spaces"
			return
		}
	}
	if len(gAgentState.userToolNames) >= ZclawMaxDynamicTools {
		result = "Error: failed to create tool (duplicate or limit reached)"
		return
	}
	gAgentState.userToolNames = append(gAgentState.userToolNames, truncateBytes(name, ZclawToolNameMaxLength - 1))
	gAgentState.userToolDescriptions = append(gAgentState.userToolDescriptions, truncateBytes(description, ZclawToolDescriptionMaxLength - 1))
	gAgentState.userToolActions = append(gAgentState.userToolActions, truncateBytes(action, ZclawCronMaxActionLength - 1))
	result = joinStrings([]str{"Created tool '", name, "': ", description})
	ok = true
}
