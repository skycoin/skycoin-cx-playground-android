package main

import "sys/string"

// Port of tools_execute of tools.c. The handler writes into a result
// buffer of TOOL_RESULT_BUF_SIZE bytes.
func toolsExecute(name str, inputJson str) (ok bool, result str) { global ZclawToolResultBufferSize
	var definitions []ToolDefinition = toolDefinitions()
	for i := 0; i < len(definitions); i++ {
		if string.EqualityByByteValue(definitions[i].name, name) {
			if string.EqualityByByteValue(name, "memory_set") {
				ok, result = toolMemorySet(inputJson)
			} else if string.EqualityByByteValue(name, "memory_get") {
				ok, result = toolMemoryGet(inputJson)
			} else if string.EqualityByByteValue(name, "memory_delete") {
				ok, result = toolMemoryDelete(inputJson)
			} else if string.EqualityByByteValue(name, "set_persona") {
				ok, result = toolSetPersona(inputJson)
			} else if string.EqualityByByteValue(name, "get_persona") {
				ok, result = toolGetPersona(inputJson)
			} else if string.EqualityByByteValue(name, "reset_persona") {
				ok, result = toolResetPersona(inputJson)
			} else if string.EqualityByByteValue(name, "delay") {
				ok, result = toolDelay(inputJson)
			} else if string.EqualityByByteValue(name, "get_version") {
				ok, result = toolGetVersion(inputJson)
			} else if string.EqualityByByteValue(name, "get_health") {
				ok, result = toolGetHealth(inputJson)
			} else if string.EqualityByByteValue(name, "create_tool") {
				ok, result = toolCreateTool(inputJson)
			} else if string.EqualityByByteValue(name, "list_user_tools") {
				ok, result = toolListUserTools(inputJson)
			} else if string.EqualityByByteValue(name, "delete_user_tool") {
				ok, result = toolDeleteUserTool(inputJson)
			} else {
				ok, result = toolUnavailable(name)
			}
			result = truncateBytes(result, ZclawToolResultBufferSize - 1)
			return
		}
	}
	ok = false
	result = truncateBytes(string.Concatenation("Unknown tool: ", name), ZclawToolResultBufferSize - 1)
}
