package main

import "sys/string"

// The tool step of the round loop of process_message of agent.c: run the
// tool the model asked for and keep the persona in step with it.
// user_tools_find of the host mock finds no user tool, and cron_set is
// refused during a cron triggered turn.
func agentToolResult(response ParsedResponse, cronTrigger bool) (result str) {
	if cronTrigger && string.EqualityByByteValue(response.toolName, "cron_set") {
		result = "Error: cron_set is not allowed during scheduled task execution. Execute the scheduled action now instead of creating a new schedule."
		return
	}
	ok, output := toolsExecute(response.toolName, response.toolInput)
	result = output
	if ok && string.EqualityByByteValue(response.toolName, "set_persona") {
		persona, found := jsonStringField(response.toolInput, 0, "persona")
		if found && agentParsePersonaName(persona) {
			gAgentState.persona = persona
		}
	} else if ok && string.EqualityByByteValue(response.toolName, "reset_persona") {
		gAgentState.persona = "neutral"
	}
}
