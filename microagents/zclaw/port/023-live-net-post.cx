package main

import "sys/string"
import "sys/os"

// liveNetPost posts body through the backendstore client, since the CX tcp
// package has no read or write. It keeps the path of url and sends it to the
// ++backend server. The client prints the status line and then the body.
func liveNetPost(url str, body str) (status i32, reply str) { global gWrapperState
	status = 0
	reply = ""
	if !liveFileWrite("net-request.json", body) {
		return
	}
	var command str = joinStrings([]str{gWrapperState.clientCommand, " post -url ", gWrapperState.backendUrl, urlPath(url), " -body net-request.json"})
	runError, exitCode, output := os.Run(command, 0, 300000, ".")
	if runError != 0 || exitCode != 0 {
		return
	}
	var newline i32 = string.ByteIndexOfFirstSubstring(output, "\n")
	if newline < 0 {
		return
	}
	status = string.ParseDecimalI32(string.SubstringByByteRange(output, 0, newline))
	reply = string.SubstringByByteRange(output, newline + 1, string.ByteLength(output))
}
