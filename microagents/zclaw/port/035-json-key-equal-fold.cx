package main

import "sys/string"

// jsonKeyEqualFold compares two object keys ignoring ASCII case, as the
// case_insensitive_strcmp behind cJSON_GetObjectItem does.
func jsonKeyEqualFold(a str, b str) (equal bool) {
	var count i32 = string.ByteLength(a)
	equal = count == string.ByteLength(b)
	var upper str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	var lower str = "abcdefghijklmnopqrstuvwxyz"
	for i := 0; equal && i < count; i++ {
		var x str = string.SubstringByByteRange(a, i, i + 1)
		var y str = string.SubstringByByteRange(b, i, i + 1)
		var xUpper i32 = string.ByteIndexOfFirstSubstring(upper, x)
		if xUpper >= 0 {
			x = string.SubstringByByteRange(lower, xUpper, xUpper + 1)
		}
		var yUpper i32 = string.ByteIndexOfFirstSubstring(upper, y)
		if yUpper >= 0 {
			y = string.SubstringByByteRange(lower, yUpper, yUpper + 1)
		}
		equal = string.EqualityByByteValue(x, y)
	}
}
