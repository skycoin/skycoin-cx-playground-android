package main

// Port of ratelimit_record_request of ratelimit.c.
func ratelimitRecordRequest() { global gAgentState
	ratelimitUpdateTimeWindow()
	gAgentState.requestsThisHour = gAgentState.requestsThisHour + 1
	gAgentState.requestsToday = gAgentState.requestsToday + 1
	var stored bool = memorySet("rl_daily", i32.str(gAgentState.requestsToday))
}
