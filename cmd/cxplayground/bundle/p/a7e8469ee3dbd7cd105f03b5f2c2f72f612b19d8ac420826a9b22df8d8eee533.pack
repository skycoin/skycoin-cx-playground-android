; CX app, text form.
[app]
name = Tap
description = Test demo: marks and prints every tap
kind = gfx
package main

import "sys/app"

func main() {
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var xs []f32
	var ys []f32
	var i i32

	for bool.not(app.ShouldClose()) {
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.TOUCH_DOWN {
				printf("down at %d %d\n", f32.i32(ex), f32.i32(ey))
			}
			if kind == app.TOUCH_UP {
				xs = append(xs, ex)
				ys = append(ys, ey)
				printf("tap %d at %d %d\n", len(xs), f32.i32(ex), f32.i32(ey))
			}
			kind, ex, ey, code = app.PollEvent()
		}
		app.Clear(0.1, 0.1, 0.12)
		app.Text(sprintf("taps: %d", len(xs)), 32.0, 40.0, 0.0, 1.0, 1.0, 1.0, 1.0)
		for i = 0; i < len(xs); i++ {
			app.Circle(xs[i], ys[i], 30.0, 1.0, 0.5, 0.2, 1.0)
		}
		app.Frame()
	}
}
