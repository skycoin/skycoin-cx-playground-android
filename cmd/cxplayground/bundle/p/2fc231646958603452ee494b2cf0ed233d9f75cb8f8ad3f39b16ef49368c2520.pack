{"name":"Benchmark: loops","description":"Integer and float loops, nested loops, iterative factorial","kind":"console"}package main

import "sys/time"

func sumInts(n i32) (s i64) {
	var i i32
	s = 0L
	for i = 0; i < n; i++ {
		s = s + i32.i64(i)
	}
}

func sumFloats(n i32) (s f64) {
	var i i32
	s = 0.0D
	for i = 0; i < n; i++ {
		s = s + i32.f64(i)*0.5D
	}
}

func nested(n i32) (c i32) {
	var i i32
	var j i32
	c = 0
	for i = 0; i < n; i++ {
		for j = 0; j < n; j++ {
			c = c + (i ^ j) % 7
		}
	}
}

func factorial(in i32) (out i32) {
	var idx i32 = 1
	out = 1
	for idx < in {
		out = out * (idx + 1)
		idx = idx + 1
	}
}

func us(t0 i64) (r i32) {
	r = i64.i32((time.UnixNano() - t0) / 1000L)
}

func main() {
	var t0 i64
	var i i32
	var f i32
	printf("loop benchmarks, CX interpreter\n")

	t0 = time.UnixNano()
	printf("sum of 0..200000 = %d   %d us\n", sumInts(200000), us(t0))

	t0 = time.UnixNano()
	printf("float sum 200000 = %d   %d us\n", f64.i64(sumFloats(200000)), us(t0))

	t0 = time.UnixNano()
	printf("nested 300x300 = %d   %d us\n", nested(300), us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 10000; i++ {
		f = factorial(10)
	}
	printf("factorial(10) x10000 = %d   %d us\n", f, us(t0))
}
