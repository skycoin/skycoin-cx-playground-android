; CX app, text form.
[app]
name = cx-forth: grid text
description = Test demo: Forth text at rows and columns of the terminal grid
kind = gfx
form = forth
entry = main.fs
\ Text at rows and columns of the terminal grid, then wait for a key.
PAGE
2 1 AT-XY ." hello from cx-forth"
2 3 AT-XY ." 6 x 7 = " 6 7 * .
GRID-SIZE 2 5 AT-XY ." grid " SWAP . ." by " .
KEY DROP
0 7 AT-XY ." bye" CR
