package main

// Port of femto_config.h and the channel names of bus/message_bus.h, for
// the build the host harness models (CONFIG_SPIRAM set, ESP32-S3 target).

var FemtoTarget str = "esp32s3"
var FemtoModel str = "claude-opus-4-5"
var FemtoMaxTokens i32 = 4096
var FemtoAgentMaxHistory i32 = 20
var FemtoAgentMaxToolIterations i32 = 10
var FemtoMaxToolCalls i32 = 4
var FemtoApiPath str = "/v1/messages"
var FemtoSpiffsMemoryDirectory str = "/spiffs/memory"
var FemtoSpiffsSessionDirectory str = "/spiffs/sessions"
var FemtoMemoryFile str = "/spiffs/memory/MEMORY.md"
var FemtoSoulFile str = "/spiffs/config/SOUL.md"
var FemtoUserFile str = "/spiffs/config/USER.md"
var FemtoChannelTelegram str = "telegram"
var FemtoChannelSystem str = "system"

// MAX_FILE_SIZE of tools/tool_files.c.
var ToolFilesMaxFileSize i32 = 32768

// The sizes of the channel and chat_id arrays of femto_msg_t.
var FemtoMessageChannelLength i32 = 16
var FemtoMessageChatIdLength i32 = 32
package main

import "sys/string"

// joinStrings concatenates parts. The port builds text with it rather than
// with sprintf, whose %s expands backslash escapes inside its arguments.
func joinStrings(parts []str) (joined str) {
	joined = ""
	for i := 0; i < len(parts); i++ {
		joined = string.Concatenation(joined, parts[i])
	}
}
package main

// How every file, network, clock and inbound operation is served, chosen at
// start by ++mode=live|record|replay.

var WrapperModeLive i32 = 0
var WrapperModeRecord i32 = 1
var WrapperModeReplay i32 = 2
package main

type WrapperState struct {
	mode i32
	byteStrings []str
	tapePath str
	tapeLines []str
	tapePosition i32
	recordedTape str
	inboundLines []str
	inboundPosition i32
	clientCommand str
	backendUrl str
	applyWrites bool
}
package main

var gWrapperState WrapperState
package main

