; CX app, text form.
[app]
name = Terminal grid resize
description = Test demo: the grid takes new columns and rows when the display turns
kind = gfx
package main

import "sys/app"

func main() {
	var w i32
	var h i32
	var cw f32
	var ch f32
	var cols i32 = 0
	var rows i32 = 0
	var c i32
	var r i32
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var i i32

	for bool.not(app.ShouldClose()) {
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.RESIZE {
				printf("resize %d x %d\n", f32.i32(ex), f32.i32(ey))
			}
			kind, ex, ey, code = app.PollEvent()
		}
		w, h = app.ScreenSize()
		cw, ch = app.CellSize()
		if cw > 0.0 {
			c = f32.i32(f32.div(i32.f32(w), cw))
			r = f32.i32(f32.div(i32.f32(h), ch))
			if c != cols {
				cols = c
				rows = r
				printf("grid cols=%d rows=%d\n", cols, rows)
			} else {
				if r != rows {
					cols = c
					rows = r
					printf("grid cols=%d rows=%d\n", cols, rows)
				}
			}
		}

		app.Clear(0.0, 0.0, 0.0)
		app.Text(sprintf("%d columns", cols), 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 1.0)
		app.Text(sprintf("%d rows", rows), 0.0, ch, 0.0, 1.0, 1.0, 1.0, 1.0)
		// A frame around the whole grid shows where it ends.
		for i = 0; i < rows; i++ {
			app.Text("|", f32.mul(i32.f32(cols-1), cw), f32.mul(i32.f32(i), ch), 0.0, 0.4, 0.8, 1.0, 1.0)
		}
		for i = 0; i < cols; i++ {
			app.Text("-", f32.mul(i32.f32(i), cw), f32.mul(i32.f32(rows-1), ch), 0.0, 0.4, 0.8, 1.0, 1.0)
		}
		app.Frame()
	}
}
