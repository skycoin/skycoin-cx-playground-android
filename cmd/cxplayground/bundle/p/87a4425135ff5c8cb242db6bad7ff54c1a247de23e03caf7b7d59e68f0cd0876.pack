{"name":"OpenGL scene","description":"Test demo: a fixed scene of shapes, compared with a reference image","kind":"gfx"}package main

import "sys/app"

func main() {
	var frames i32 = 0
	for bool.not(app.ShouldClose()) {
		app.Clear(0.05, 0.05, 0.1)
		app.Rect(40.0, 40.0, 280.0, 160.0, 0.9, 0.2, 0.2, 1.0)
		app.Rect(200.0, 120.0, 280.0, 160.0, 0.2, 0.4, 0.9, 0.6)
		app.Circle(560.0, 140.0, 100.0, 0.2, 0.8, 0.3, 1.0)
		app.Tri(80.0, 560.0, 360.0, 300.0, 640.0, 560.0, 1.0, 0.8, 0.1, 1.0)
		app.Line(40.0, 620.0, 680.0, 620.0, 8.0, 1.0, 1.0, 1.0, 1.0)
		app.Line(40.0, 660.0, 680.0, 760.0, 4.0, 0.7, 0.3, 0.9, 1.0)
		app.Circle(360.0, 430.0, 40.0, 0.05, 0.05, 0.1, 1.0)
		app.Frame()
		frames = frames + 1
		if frames == 1 {
			printf("scene drawn\n")
		}
	}
}
