{"name":"CX source: primes","description":"Test demo: the primes benchmark as CX source","kind":"console","entry":"primes.cx"}package main

// A sieve, deterministic Miller-Rabin and Lucas-Lehmer, see ../../README.md.

var sieve [100000]i32

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func powmod(base ui64, exp ui64, n ui64) (out ui64) {
	var r ui64
	r = 1UL
	var a ui64
	a = base % n
	var d ui64
	d = exp
	for d > 0UL {
		if (d & 1UL) == 1UL {
			r = r * a % n
		}
		a = a * a % n
		d = d >> 1UL
	}
	out = r
}

func witness(a ui64, d ui64, s ui64, n ui64) (composite bool) {
	composite = false
	if a % n != 0UL {
		var x ui64
		x = powmod(a, d, n)
		if x != 1UL && x != n - 1UL {
			composite = true
			var r ui64
			for r = 1UL; r < s && composite; r++ {
				x = x * x % n
				if x == n - 1UL {
					composite = false
				}
			}
		}
	}
}

func millerRabin(n ui64) (prime bool) {
	if n < 2UL {
		prime = false
	} else if n % 2UL == 0UL {
		prime = n == 2UL
	} else {
		var d ui64
		d = n - 1UL
		var s ui64
		s = 0UL
		for d % 2UL == 0UL {
			d = d / 2UL
			s++
		}
		prime = !witness(2UL, d, s, n) && !witness(7UL, d, s, n) && !witness(61UL, d, s, n)
	}
}

func mulmod(x ui64, y ui64, m ui64) (out ui64) {
	var r ui64
	r = 0UL
	var a ui64
	a = x % m
	var b ui64
	b = y
	for b > 0UL {
		if (b & 1UL) == 1UL {
			r = r + a
			if r >= m {
				r = r - m
			}
		}
		a = a + a
		if a >= m {
			a = a - m
		}
		b = b >> 1UL
	}
	out = r
}

func lucasLehmer(p ui64) (prime bool) {
	var m ui64
	m = (1UL << p) - 1UL
	var s ui64
	s = 4UL
	var i ui64
	for i = 0UL; i < p - 2UL; i++ {
		s = mulmod(s, s, m)
		s = (s + m - 2UL) % m
	}
	prime = s == 0UL
}

func main() { global sieve
	var h ui64
	h = 14695981039346656037UL
	var ok bool
	ok = true

	var n i32
	n = 100000
	var i i32
	var j i32
	for i = 2; i < n; i++ {
		sieve[i] = 1
	}
	for i = 2; i * i < n; i++ {
		if sieve[i] == 1 {
			for j = i * i; j < n; j = j + i {
				sieve[j] = 0
			}
		}
	}
	var count i32
	count = 0
	for i = 2; i < n; i++ {
		count = count + sieve[i]
	}
	h = fnv(h, i32.ui64(count))
	ok = ok && count == 9592

	var mrCount i32
	mrCount = 0
	var k ui64
	for k = 0UL; k < 15000UL; k++ {
		if millerRabin(k) {
			mrCount++
		}
	}
	h = fnv(h, i32.ui64(mrCount))
	ok = ok && mrCount == 1754

	var exponents [17]ui64
	exponents[0] = 3UL
	exponents[1] = 5UL
	exponents[2] = 7UL
	exponents[3] = 11UL
	exponents[4] = 13UL
	exponents[5] = 17UL
	exponents[6] = 19UL
	exponents[7] = 23UL
	exponents[8] = 29UL
	exponents[9] = 31UL
	exponents[10] = 37UL
	exponents[11] = 41UL
	exponents[12] = 43UL
	exponents[13] = 47UL
	exponents[14] = 53UL
	exponents[15] = 59UL
	exponents[16] = 61UL
	var mask ui64
	var round i32
	for round = 0; round < 1; round++ {
		mask = 0UL
		for i = 0; i < 17; i++ {
			if lucasLehmer(exponents[i]) {
				mask = mask | (1UL << exponents[i])
				h = fnv(h, 1UL)
			} else {
				h = fnv(h, 0UL)
			}
		}
		ok = ok && mask == 2305843011361841320UL
	}

	ui64.print(h)
	if ok {
		printf("primes pass\n")
	} else {
		printf("primes FAIL\n")
	}
}
