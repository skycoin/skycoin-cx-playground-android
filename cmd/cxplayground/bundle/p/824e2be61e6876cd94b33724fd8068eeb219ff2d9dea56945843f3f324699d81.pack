{"name":"Test program: storage and serial","description":"Block write, read and verify through the file system; direct block and serial tests skipped on the phone, one result line each","kind":"console"}package main

// Test program 2 of skycoin-cx-playground-android #19: storage block tests
// and serial tests. Every test prints one result line, see
// testreport.Result. On Android storage is the file system only (D29 of
// docs/ProgramDistribution.md): method A writes and reads one file per
// block size and verifies each block after the read back. Method B, direct
// block access, is ESP32 only, so its tests report skipped, and so do the
// serial tests, since the phone has no UART or SPI.

import "sys/os"
import "sys/time"

// blocksPerSize is the number of blocks each storage test writes and reads.
var blocksPerSize i32 = 64

// decimalThousandths formats value / 1000 with three decimals.
func decimalThousandths(value i64) (text str) {
	var fraction i64
	fraction = value % 1000L
	text = sprintf("%d.", value / 1000L)
	if fraction < 100L {
		text = sprintf("%s0", text)
	}
	if fraction < 10L {
		text = sprintf("%s0", text)
	}
	text = sprintf("%s%d", text, fraction)
}

// reportResult prints the result line of one test. bytes counts every
// byte written and read, elapsed covers only the measured work.
func reportResult(name str, passed bool, blocks i64, bytes i64, elapsed i64, note str) {
	if elapsed < 1L {
		elapsed = 1L
	}
	if blocks < 1L {
		blocks = 1L
	}
	var verdict str
	verdict = "false"
	if passed {
		verdict = "true"
	}
	printf("%s %s %d %d %s %s\n", name, verdict, blocks * 1000000000L / elapsed, bytes * 1000000000L / (elapsed * 1024L), decimalThousandths(elapsed / blocks), note)
}

// blockPattern returns the bytes of block number block at size, different
// for every block and size so a block read from the wrong place differs.
func blockPattern(size i32, block i32) (data []ui8) {
	var i i32
	for i = 0; i < size; i++ {
		data = append(data, i32.ui8(i*7 + block*29 + size/512))
	}
}

func countMismatches(want []ui8, got []ui8) (bad i32) {
	var i i32
	bad = 0
	if len(got) != len(want) {
		bad = len(want)
		return
	}
	for i = 0; i < len(want); i++ {
		if got[i] != want[i] {
			bad++
		}
	}
}

func storageNote(size i32, failures i32, mismatches i32) (note str) { global blocksPerSize
	note = sprintf("block=%dB blocks=%d failures=%d mismatches=%d", size, blocksPerSize, failures, mismatches)
}

// testStorageFileSystem is method A at size: StorageFileSystemWrite<size>
// creates fs-<size>.bin and writes the blocks one after another, and
// StorageFileSystemRead<size> opens it again and reads and verifies them.
// Create, open and close count in the time, the pattern work does not.
func testStorageFileSystem(size i32) { global blocksPerSize
	var name str
	name = sprintf("fs-%d.bin", size)
	var handle i32
	var block i32
	var data []ui8
	var got []ui8
	var ok bool
	var t0 i64
	var elapsed i64
	var failures i32
	var mismatches i32

	failures = 0
	elapsed = 0L
	t0 = time.UnixNano()
	handle = os.Create(name)
	elapsed = elapsed + time.UnixNano() - t0
	if handle < 0 {
		failures++
	}
	for block = 0; block < blocksPerSize; block++ {
		data = blockPattern(size, block)
		t0 = time.UnixNano()
		ok = os.WriteUI8Slice(handle, data)
		elapsed = elapsed + time.UnixNano() - t0
		if !ok {
			failures++
		}
	}
	t0 = time.UnixNano()
	ok = os.Close(handle)
	elapsed = elapsed + time.UnixNano() - t0
	if !ok {
		failures++
	}
	reportResult(sprintf("StorageFileSystemWrite%d", size), failures == 0, i32.i64(blocksPerSize), i32.i64(blocksPerSize * size), elapsed, storageNote(size, failures, 0))

	failures = 0
	mismatches = 0
	elapsed = 0L
	t0 = time.UnixNano()
	handle = os.Open(name)
	elapsed = elapsed + time.UnixNano() - t0
	if handle < 0 {
		failures++
	}
	for block = 0; block < blocksPerSize; block++ {
		t0 = time.UnixNano()
		got, ok = os.ReadUI8Slice(handle, got, i32.ui64(size))
		elapsed = elapsed + time.UnixNano() - t0
		if !ok {
			failures++
		}
		mismatches = mismatches + countMismatches(blockPattern(size, block), got)
	}
	t0 = time.UnixNano()
	ok = os.Close(handle)
	elapsed = elapsed + time.UnixNano() - t0
	reportResult(sprintf("StorageFileSystemRead%d", size), failures == 0 && mismatches == 0, i32.i64(blocksPerSize), i32.i64(blocksPerSize * size), elapsed, storageNote(size, failures, mismatches))
}

// testStorageCorruptionDetectedByteFlip writes one block to a file, flips
// one byte of it through the file system and passes when the read back
// finds exactly that byte.
func testStorageCorruptionDetectedByteFlip() {
	var size i32
	size = 512
	var data []ui8
	var got []ui8
	var ok bool
	var handle i32
	var t0 i64
	var mismatches i32
	data = blockPattern(size, 0)
	t0 = time.UnixNano()
	handle = os.Create("flip.bin")
	ok = handle >= 0
	ok = os.WriteUI8Slice(handle, data) && ok
	ok = os.Seek(handle, 100L, 0) == 100L && ok
	ok = os.WriteUI8(handle, data[100] ^ 255UB) && ok
	ok = os.Close(handle) && ok
	handle = os.Open("flip.bin")
	got, ok = os.ReadUI8Slice(handle, got, i32.ui64(size))
	ok = os.Close(handle) && ok
	mismatches = countMismatches(data, got)
	reportResult("StorageCorruptionDetectedByteFlip", ok && mismatches == 1, 2L, i32.i64(size * 2), time.UnixNano() - t0, sprintf("block=%dB injected=1 mismatches=%d", size, mismatches))
}

// reportSkipped prints the result line of a test that does not run on the
// phone.
func reportSkipped(name str, reason str) {
	printf("%s skipped - - - - - %s\n", name, reason)
}

func main() {
	var sizes [4]i32
	sizes[0] = 512
	sizes[1] = 1024
	sizes[2] = 2048
	sizes[3] = 4096
	var i i32
	printf("test program storage and serial\n")
	reportSkipped("SerialSpiRead", "no SPI on the phone")
	reportSkipped("SerialSpiWrite", "no SPI on the phone")
	reportSkipped("SerialUartRead", "no UART on the phone")
	reportSkipped("SerialUartWrite", "no UART on the phone")
	for i = 0; i < 4; i++ {
		reportSkipped(sprintf("StorageDirectBlockWrite%d", sizes[i]), "direct block access is ESP32 only")
		reportSkipped(sprintf("StorageDirectBlockRead%d", sizes[i]), "direct block access is ESP32 only")
	}
	testStorageCorruptionDetectedByteFlip()
	for i = 0; i < 4; i++ {
		testStorageFileSystem(sizes[i])
	}
	printf("test program done\n")
}
