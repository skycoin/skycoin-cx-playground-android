package main

import "sys/string"

// inboundNext is the wrapper for the inbound message queue, the port of
// message_bus_pop_inbound. Live messages come from the ++inbound file, one
// per line as channel, chat id and content separated by tabs.
func inboundNext() (message InboundMessage, found bool) { global gWrapperState, WrapperModeReplay, WrapperModeRecord
	found = false
	if gWrapperState.mode == WrapperModeReplay {
		var kind str = tapePeekKind()
		if string.EqualityByByteValue(kind, "inbound-end") {
			var end []str = tapeNext("inbound-end", 1)
			return
		}
		var fields []str = tapeNext("inbound", 4)
		message = InboundMessage{channel: fields[1], chatId: fields[2], content: fields[3]}
		found = true
		return
	}
	if gWrapperState.inboundPosition >= len(gWrapperState.inboundLines) {
		if gWrapperState.mode == WrapperModeRecord {
			tapeRecord([]str{"inbound-end"})
		}
		return
	}
	var fields []str = tapeSplitFields(gWrapperState.inboundLines[gWrapperState.inboundPosition])
	gWrapperState.inboundPosition = gWrapperState.inboundPosition + 1
	if len(fields) != 3 {
		fatalStop(joinStrings([]str{"inbound line ", i32.str(gWrapperState.inboundPosition), " needs channel, chat id and content"}))
	}
	message = InboundMessage{channel: fields[0], chatId: fields[1], content: fields[2]}
	found = true
	if gWrapperState.mode == WrapperModeRecord {
		tapeRecord([]str{"inbound", message.channel, message.chatId, message.content})
	}
}
