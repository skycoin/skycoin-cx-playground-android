package main

import "sys/time"
import "sys/string"

type Point struct {
	X i32
	Y i32
}

func us(t0 i64) (r i32) {
	r = i64.i32((time.UnixNano() - t0) / 1000L)
}

func main() {
	var t0 i64
	var i i32
	var ints []i32
	var pts []Point
	var p Point
	var s str = ""
	var sum i32 = 0
	printf("allocation benchmarks, CX interpreter\n")

	t0 = time.UnixNano()
	for i = 0; i < 50000; i++ {
		ints = append(ints, i)
	}
	printf("append 50000 i32: len %d   %d us\n", len(ints), us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 20000; i++ {
		p.X = i
		p.Y = i * 2
		pts = append(pts, p)
	}
	for i = 0; i < len(pts); i++ {
		sum = sum + pts[i].Y % 10
	}
	printf("append 20000 structs, sum %d   %d us\n", sum, us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 2000; i++ {
		s = string.Concatenation(s, "x")
	}
	printf("concat 2000 strings: len %d   %d us\n", len(s), us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 5000; i++ {
		s = sprintf("%d-%d", i, i*i)
	}
	printf("sprintf x5000: last %s   %d us\n", s, us(t0))
}
