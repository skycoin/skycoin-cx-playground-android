package main

// wrapperFinish writes the recorded tape, or checks that a replay read all of it.
func wrapperFinish() { global gWrapperState, WrapperModeRecord, WrapperModeReplay
	if gWrapperState.mode == WrapperModeRecord {
		if !liveFileWrite(gWrapperState.tapePath, gWrapperState.recordedTape) {
			fatalStop(joinStrings([]str{"cannot write tape ", gWrapperState.tapePath}))
		}
	}
	if gWrapperState.mode == WrapperModeReplay {
		if gWrapperState.tapePosition != len(gWrapperState.tapeLines) {
			fatalStop(joinStrings([]str{"replay read ", i32.str(gWrapperState.tapePosition), " of ", i32.str(len(gWrapperState.tapeLines)), " tape records"}))
		}
	}
}
