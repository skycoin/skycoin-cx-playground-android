package main

import "sys/app"
import "sys/string"

func main() {
	var kind i32
	var ex f32
	var ey f32
	var code i32
	var text str = ""
	var lines i32 = 0

	for bool.not(app.ShouldClose()) {
		kind, ex, ey, code = app.PollEvent()
		for kind != app.NONE {
			if kind == app.KEY {
				if code == app.KEY_ENTER {
					lines = lines + 1
					printf("line %d: [%s] %d bytes\n", lines, text, len(text))
					text = ""
				} else {
					if code == app.KEY_BACKSPACE {
						if len(text) > 0 {
							text = string.SubstringByByteRange(text, 0, len(text)-1)
						}
					} else {
						text = string.Concatenation(text, app.Rune(code))
					}
				}
			}
			kind, ex, ey, code = app.PollEvent()
		}
		app.Clear(0.1, 0.1, 0.12)
		app.Text(string.Concatenation("> ", text), 32.0, 40.0, 0.0, 0.6, 1.0, 0.6, 1.0)
		app.Text(sprintf("lines: %d", lines), 32.0, 120.0, 0.0, 1.0, 1.0, 1.0, 1.0)
		app.Frame()
	}
}
