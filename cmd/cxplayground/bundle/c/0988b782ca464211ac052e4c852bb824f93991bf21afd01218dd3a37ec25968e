package main

import "sys/string"

// Port of tool_write_file_execute of tools/tool_files.c.
func toolWriteFile(inputJson str) (output str) {
	path, pathFound := jsonStringField(inputJson, 0, "path")
	content, contentFound := jsonStringField(inputJson, 0, "content")
	if !pathFound || !toolValidatePath(path) {
		output = "Error: path must start with /spiffs/ and must not contain '..'"
		return
	}
	if !contentFound {
		output = "Error: missing 'content' field"
		return
	}
	if !fileWrite(path, content) {
		output = joinStrings([]str{"Error: cannot open file for writing: ", path})
		return
	}
	output = joinStrings([]str{"OK: wrote ", i32.str(string.ByteLength(content)), " bytes to ", path})
}
