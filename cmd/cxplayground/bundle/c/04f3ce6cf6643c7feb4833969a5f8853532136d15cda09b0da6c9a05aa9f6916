package main

import "sys/time"

// The algorithms of skycoin-cx/benchmarks/cx, run in a loop and timed.

func ackermann(a i32, b i32) (out i32) {
	if i32.eq(a, 0) {
		out = i32.add(b, 1)
	} else {
		if i32.eq(b, 0) {
			out = ackermann(i32.sub(a, 1), 1)
		} else {
			out = ackermann(i32.sub(a, 1), ackermann(a, i32.sub(b, 1)))
		}
	}
}

func factorialIter(in i32) (out i32) {
	out = 1
	var idx i32
	idx = 1
	for i32.lt(idx, in) {
		out = i32.mul(out, i32.add(idx, 1))
		idx = i32.add(idx, 1)
	}
}

func factorialRec(in i32) (out i32) {
	if in <= 1 {
		out = 1
	} else {
		out = in * factorialRec(in-1)
	}
}

func digitSum(i i32, base i32) (out i32) {
	out = 0
	for ; i32.gt(i, 0); i = i32.div(i, base) {
		out = i32.add(out, i32.mod(i, base))
	}
}

func digitalRoot(in i32, base i32) (root i32, persistence i32) {
	root = in
	persistence = 0
	for root >= base {
		root = digitSum(root, base)
		persistence = persistence + 1
	}
}

func us(t0 i64) (r i32) {
	r = i64.i32((time.UnixNano() - t0) / 1000L)
}

func main() {
	var t0 i64
	var i i32
	var r i32
	var p i32
	printf("skycoin-cx benchmarks\n")

	t0 = time.UnixNano()
	r = ackermann(2, 3)
	printf("ackermann(2,3) = %d   %d us\n", r, us(t0))

	t0 = time.UnixNano()
	r = ackermann(3, 3)
	printf("ackermann(3,3) = %d   %d us\n", r, us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 1000; i++ {
		r = factorialIter(12)
	}
	printf("factorial iterative(12) x1000 = %d   %d us\n", r, us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 1000; i++ {
		r = factorialRec(12)
	}
	printf("factorial recursive(12) x1000 = %d   %d us\n", r, us(t0))

	t0 = time.UnixNano()
	for i = 0; i < 1000; i++ {
		r, p = digitalRoot(79563, 10)
	}
	printf("digital root(79563) x1000 = %d, persistence %d   %d us\n", r, p, us(t0))
}
