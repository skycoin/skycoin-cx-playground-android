package main

import "sys/string"

// splitLines splits text at newlines and drops empty lines.
func splitLines(text str) (lines []str) {
	var rest str = text
	var newline i32 = string.ByteIndexOfFirstSubstring(rest, "\n")
	for newline >= 0 {
		if newline > 0 {
			lines = append(lines, string.SubstringByByteRange(rest, 0, newline))
		}
		rest = string.SubstringByByteRange(rest, newline + 1, string.ByteLength(rest))
		newline = string.ByteIndexOfFirstSubstring(rest, "\n")
	}
	if string.ByteLength(rest) > 0 {
		lines = append(lines, rest)
	}
}
