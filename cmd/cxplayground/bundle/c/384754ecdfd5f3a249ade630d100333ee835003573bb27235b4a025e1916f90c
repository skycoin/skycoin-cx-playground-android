package main

import "sys/string"

// utf8Encode returns the UTF-8 bytes of a code point.
func utf8Encode(code i32) (encoded str) { global gWrapperState
	var table []str = gWrapperState.byteStrings
	if code < 128 {
		encoded = table[code]
	} else if code < 2048 {
		encoded = string.Concatenation(table[192 + code / 64], table[128 + code % 64])
	} else if code < 65536 {
		encoded = string.Concatenation(table[224 + code / 4096], string.Concatenation(table[128 + (code / 64) % 64], table[128 + code % 64]))
	} else {
		encoded = string.Concatenation(table[240 + code / 262144], table[128 + (code / 4096) % 64])
		encoded = string.Concatenation(encoded, string.Concatenation(table[128 + (code / 64) % 64], table[128 + code % 64]))
	}
}
