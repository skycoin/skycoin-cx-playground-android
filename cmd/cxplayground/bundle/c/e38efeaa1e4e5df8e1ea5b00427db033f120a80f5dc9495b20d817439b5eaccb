package main

import "sys/string"

func tapeUnescape(s str) (plain str) {
	plain = ""
	var rest str = s
	var slash i32 = string.ByteIndexOfFirstSubstring(rest, "\\")
	for slash >= 0 {
		plain = string.Concatenation(plain, string.SubstringByByteRange(rest, 0, slash))
		var code str = string.SubstringByByteRange(rest, slash + 1, slash + 2)
		if string.EqualityByByteValue(code, "n") {
			plain = string.Concatenation(plain, "\n")
		} else if string.EqualityByByteValue(code, "t") {
			plain = string.Concatenation(plain, "\t")
		} else if string.EqualityByByteValue(code, "r") {
			plain = string.Concatenation(plain, "\r")
		} else {
			plain = string.Concatenation(plain, code)
		}
		rest = string.SubstringByByteRange(rest, slash + 2, string.ByteLength(rest))
		slash = string.ByteIndexOfFirstSubstring(rest, "\\")
	}
	plain = string.Concatenation(plain, rest)
}
