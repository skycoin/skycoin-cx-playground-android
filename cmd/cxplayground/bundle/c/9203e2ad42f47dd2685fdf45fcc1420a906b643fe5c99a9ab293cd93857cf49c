package main

import "sys/string"

// jsonHexFour reads the four hex digits at position, or returns -1.
func jsonHexFour(s str, position i32) (code i32) {
	code = 0
	if position + 4 > string.ByteLength(s) {
		code = -1
		return
	}
	for i := 0; i < 4; i++ {
		var digit i32 = hexValue(string.SubstringByByteRange(s, position + i, position + i + 1))
		if digit < 0 {
			code = -1
			return
		}
		code = code * 16 + digit
	}
}
