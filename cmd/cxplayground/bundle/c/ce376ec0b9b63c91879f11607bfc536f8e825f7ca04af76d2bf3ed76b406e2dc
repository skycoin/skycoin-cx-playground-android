package main

import "sys/string"

// tapePeekKind returns the kind of the next unread tape record, or "" at the end.
func tapePeekKind() (kind str) { global gWrapperState
	kind = ""
	if gWrapperState.tapePosition < len(gWrapperState.tapeLines) {
		var line str = gWrapperState.tapeLines[gWrapperState.tapePosition]
		var tab i32 = string.ByteIndexOfFirstSubstring(line, "\t")
		kind = line
		if tab >= 0 {
			kind = string.SubstringByByteRange(line, 0, tab)
		}
	}
}
