package main

import "sys/string"

// Port of skill_loader_build_summary of skills/skill_loader.c. The summary
// is cut at size - 1 bytes; past that the C code writes beyond its buffer,
// which no test reaches.
func skillBuildSummary(size i32) (summary str) {
	summary = ""
	names, found := dirList()
	if !found {
		return
	}
	for i := 0; i < len(names); i++ {
		var name str = names[i]
		var nameLength i32 = string.ByteLength(name)
		var full bool = string.ByteLength(summary) >= size - 1
		var matches bool = !full && string.ByteIndexOfFirstSubstring(name, "skills/") == 0 && nameLength >= 11
		if matches {
			matches = string.EqualityByByteValue(string.SubstringByByteRange(name, nameLength - 3, nameLength), ".md")
		}
		if matches {
			var fullPath str = string.Concatenation("/spiffs/", name)
			content, opened := fileRead(fullPath)
			firstLine, afterFirst, lineFound := skillReadLine(content, 0, 128)
			if opened && lineFound {
				var title str = skillExtractTitle(firstLine, 64)
				var description str = skillExtractDescription(content, afterFirst, 256)
				summary = string.Concatenation(summary, joinStrings([]str{"- **", title, "**: ", description, " (read with: read_file ", fullPath, ")\n"}))
				if string.ByteLength(summary) > size - 1 {
					summary = string.SubstringByByteRange(summary, 0, size - 1)
				}
			}
		}
	}
}
