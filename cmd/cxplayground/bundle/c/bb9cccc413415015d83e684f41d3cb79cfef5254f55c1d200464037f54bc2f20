package main

import "sys/string"

// Port of tool_read_file_execute of tools/tool_files.c. The input is JSON the
// reply parser already accepted, so cJSON_Parse cannot fail; input that is
// not an object has no path, as cJSON_GetObjectItem finds none.
func toolReadFile(inputJson str) (output str) {
	path, pathFound := jsonStringField(inputJson, 0, "path")
	if !pathFound || !toolValidatePath(path) {
		output = "Error: path must start with /spiffs/ and must not contain '..'"
		return
	}
	content, found := fileRead(path)
	if !found {
		output = joinStrings([]str{"Error: file not found: ", path})
		return
	}
	output = content
}
