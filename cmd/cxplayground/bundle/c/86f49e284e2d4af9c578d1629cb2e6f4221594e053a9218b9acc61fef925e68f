package main

import "sys/string"

// Port of tool_edit_file_execute of tools/tool_files.c: replace the first
// occurrence of old_string, as strstr finds it, and write the file back.
func toolEditFile(inputJson str) (output str) {
	path, pathFound := jsonStringField(inputJson, 0, "path")
	oldText, oldFound := jsonStringField(inputJson, 0, "old_string")
	newText, newFound := jsonStringField(inputJson, 0, "new_string")
	if !pathFound || !toolValidatePath(path) {
		output = "Error: path must start with /spiffs/ and must not contain '..'"
		return
	}
	if !oldFound || !newFound {
		output = "Error: missing 'old_string' or 'new_string' field"
		return
	}
	content, found := fileRead(path)
	if !found {
		output = joinStrings([]str{"Error: file not found: ", path})
		return
	}
	var size i32 = string.ByteLength(content)
	if size <= 0 || size > ToolFilesMaxFileSize {
		output = joinStrings([]str{"Error: file too large or empty (", i32.str(size), " bytes)"})
		return
	}
	var position i32 = string.ByteIndexOfFirstSubstring(content, oldText)
	if position < 0 {
		output = joinStrings([]str{"Error: old_string not found in ", path})
		return
	}
	var oldLength i32 = string.ByteLength(oldText)
	var edited str = joinStrings([]str{string.SubstringByByteRange(content, 0, position), newText, string.SubstringByByteRange(content, position + oldLength, size)})
	if !fileWrite(path, edited) {
		output = joinStrings([]str{"Error: cannot open file for writing: ", path})
		return
	}
	output = joinStrings([]str{"OK: edited ", path, " (replaced ", i32.str(oldLength), " bytes with ", i32.str(string.ByteLength(newText)), " bytes)"})
}
